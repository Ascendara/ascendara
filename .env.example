# Firebase Configuration
# Firebase will automatically initialize if credentials are provided
# Leave these empty for development mode without Firebase
# Get these values from your Firebase project settings:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Build only. These are NOT loaded from .env by the signature/registration scripts.
# Export them in your shell, or configure GitHub Actions Secrets.
BUILD_SECRET=
ADMIN_POST_KEY=

# Existing Electron production configuration. CI writes electron/config.prod.js.
# These client values are recoverable from packaged applications; never use
# server/admin credentials here. Only SECRET_SEED is required for official releases.
ASCENDARA_SECRET_SEED=
REACT_APP_AUTHORIZATION=
REACT_APP_ASCENDARA_API_KEY=
REACT_APP_IMAGE_KEY=
REACT_APP_DISCKEY=

# Optional Windows signing (electron-builder standard names).
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=

# Optional macOS signing: CSC_LINK is a base64 Developer ID Application .p12.
CSC_LINK=
CSC_KEY_PASSWORD=
ASCENDARA_MAC_SIGN_IDENTITY=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
