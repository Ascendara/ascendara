{
  "name": "ascendara",
  "version": "11.7.3",
  "main": "electrobun/main.js",
  "description": "Skip extracting files, navigating setup processes, or any unnecessary hassles.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ascendara/ascendara.git",
    "baseUrl": "https://github.com/Ascendara/ascendara"
  },
  "license": "CC-BY-NC-1.0",
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "author": "tagoWorks",
  "keywords": [
    "electrobun",
    "vite",
    "setup",
    "installer",
    "automation",
    "onboarding",
    "user-experience",
    "cross-platform",
    "desktop-app",
    "productivity",
    "hassle-free",
    "quick-start",
    "packaging",
    "software-launcher",
    "configuration"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "audit:code": "node scripts/audit-code.cjs",
    "lint": "eslint src electron electrobun binaries/AscendaraAchievementWatcher/src scripts/*.cjs tests/*.cjs",
    "dev": "vite --mode development",
    "build": "vite build",
    "start": "npx --yes electrobun@2.0.5 prepare && node scripts/electrobun/stage-app.cjs --env=dev && npx --yes electrobun@2.0.5 dev",
    "dist": "python3 ./scripts/build_ascendara.py",
    "package": "yarn build && node scripts/electrobun/stage-app.cjs --env=stable --allow-missing && npx --yes electrobun@2.0.5 build --env=stable",
    "dist-linux": "python3 ./scripts/build_ascendara_linux.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "dist-mac": "python3 ./scripts/build_ascendara_mac.py",
    "setup-mac": "python3 ./scripts/setup_macos_tools.py",
    "setup-highball": "python3 ./scripts/build_highball.py",
    "test-mac-extraction": "python3 -m unittest discover -s tests -p 'test_macos*.py'",
    "dist-mac-arm64": "python3 ./scripts/build_ascendara_mac.py --arch arm64",
    "dist-mac-intel": "python3 ./scripts/build_ascendara_mac.py --arch x64"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "archiver": "^7.0.1",
    "axios": "^1.13.5",
    "babel-plugin-react-compiler": "^19.0.0-beta-27714ef-20250124",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "discord-rpc": "^4.0.1",
    "dompurify": "^3.4.15",
    "dotenv": "^17.3.1",
    "firebase": "^12.9.0",
    "framer-motion": "^12.34.3",
    "fs-extra": "^11.3.3",
    "gifenc": "1.0.3",
    "i18next": "^25.8.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.4",
    "node-machine-id": "^1.1.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "sax": "^1.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "unzipper": "^0.12.1",
    "winreg": "^1.2.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/parser": "7",
    "@babel/traverse": "7",
    "@eslint/js": "9",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "baseline-browser-mapping": "^2.11.21",
    "caniuse-lite": "^1.0.30001810",
    "eslint": "9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "html-to-image": "^1.11.11",
    "husky": "^9.1.7",
    "jsdom": "26",
    "lint-staged": "^16.2.7",
    "postcss": "8",
    "prettier": "^3.8.1",
    "prettier-plugin-sort-json": "4.1.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "*.{js,jsx,json,md,html,css}": [
      "prettier --write"
    ]
  }
}
